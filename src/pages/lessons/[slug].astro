---
import Contents from "../../components/Contents.astro";
import Exercise from "../../components/Exercise.astro";
import Footer from "../../components/Footer.astro";
import Progress from "../../components/Progress.astro";
import Base from "../../layouts/Base.astro";
import { getLessons, lessonUrl, PARTS, type Lesson } from "../../lib/lessons";

export async function getStaticPaths() {
  const lessons = await getLessons();
  return lessons.map((lesson) => ({ params: { slug: lesson.slug }, props: { lesson, lessons } }));
}

interface Props {
  lesson: Lesson;
  lessons: Lesson[];
}

const { lesson, lessons } = Astro.props;
const { part, title, intro, tasks } = lesson.data;
const previous = lessons[lesson.number - 2];
const next = lessons[lesson.number];
---

<Base title={title} section="roadmap" description={intro}>
  <div class="book">
    <details class="sidebar" data-sidebar>
      <summary>
        Contents · Lesson {lesson.number} of {lessons.length}
      </summary>
      <Contents lessons={lessons} current={lesson.number} />
    </details>

    <main data-lesson={lesson.number - 1}>
      <p class="label">
        {PARTS[part]} · {part} · Lesson {lesson.number}
      </p>
      <h1>{title}</h1>
      <p class="lede">{intro}</p>

      <div class="progress">
        <span data-progress-text>0 of {tasks.length} complete</span>
        <span class="meter">
          <i data-meter></i>
        </span>
        <button type="button" class="button" data-know hidden>
          I already know this lesson
        </button>
      </div>

      <div class="locked" data-locked hidden>
        <span>
          This lesson unlocks when you finish lesson <span data-unlocks-after></span>. You can still
          read it. Already past this point?
        </span>
        <button type="button" class="button" data-skip>
          Mark lessons 1 to {lesson.number - 1} as known
        </button>
      </div>

      <ol class="exercises">
        {tasks.map((task, i) => (
          <Exercise task={task} number={`${lesson.number}.${i + 1}`} />
        ))}
      </ol>

      <nav class="pager" aria-label="Lessons">
        {previous ? (
          <a href={lessonUrl(previous)}>
            Lesson {previous.number}: {previous.data.title}
          </a>
        ) : (
          <span />
        )}
        {next && (
          <a href={lessonUrl(next)}>
            Lesson {next.number}: {next.data.title}
          </a>
        )}
      </nav>

      <Footer withReset />
    </main>
  </div>
  <Progress lessons={lessons} />
</Base>

<script>
  // The contents list is a sidebar on wide screens and a collapsible panel on phones.
  const sidebar = document.querySelector<HTMLDetailsElement>("[data-sidebar]")!;
  const wide = matchMedia("(min-width: 861px)");
  const sync = () => (sidebar.open = wide.matches);
  wide.addEventListener("change", sync);
  sync();
</script>

<style>
  .book {
    display: grid;
    grid-template-columns: 290px minmax(0, 1fr);
    gap: 0 clamp(24px, 4vw, 56px);
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 48px);
  }
  .sidebar {
    position: sticky;
    top: 0;
    align-self: start;
    max-height: 100vh;
    overflow-y: auto;
    padding: 28px 0 40px;
  }
  summary {
    cursor: pointer;
    font-weight: 600;
    padding: 4px 0;
  }
  main {
    padding: 36px 0 80px;
    min-width: 0;
  }
  .progress {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    padding: 10px 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    font-size: 15px;
    color: var(--muted);
  }
  .meter {
    flex: 1;
    min-width: 120px;
    height: 3px;
    background: var(--rule);
  }
  .meter i {
    display: block;
    width: 0;
    height: 100%;
    background: var(--accent);
  }
  .locked {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
    margin: 24px 0 0;
    padding: 14px 18px;
    border: 1px solid var(--ink);
  }
  .exercises {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 40px;
    font-size: 16px;
  }
  @media (min-width: 861px) {
    summary {
      display: none;
    }
  }
  @media (max-width: 860px) {
    .book {
      grid-template-columns: 1fr;
    }
    .sidebar {
      position: static;
      max-height: none;
      padding: 12px 0;
      border-bottom: 1px solid var(--rule);
    }
    main {
      padding-top: 24px;
    }
  }
</style>
