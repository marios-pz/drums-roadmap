---
import "@fontsource-variable/source-serif-4";
import "@fontsource-variable/source-serif-4/wght-italic.css";
import "../styles/global.css";
import { url } from "../lib/url";

interface Props {
  title: string;
  description: string;
  section: "roadmap" | "genres" | "sticks";
}

const { title, description, section } = Astro.props;
const nav = [
  { id: "roadmap", label: "Roadmap", href: url() },
  { id: "genres", label: "Genres", href: url("genres/") },
  { id: "sticks", label: "Sticks", href: url("sticks/") },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === "Drums Roadmap" ? title : `${title} · Drums Roadmap`}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={url("favicon.svg")} type="image/svg+xml" />
  </head>
  <body>
    <header>
      <a class="wordmark" href={url()}>
        Drums <i>Roadmap</i>
      </a>
      <nav aria-label="Site">
        {nav.map((item) => (
          <a href={item.href} aria-current={item.id === section ? "page" : undefined}>
            {item.label}
          </a>
        ))}
      </nav>
    </header>
    <slot />
  </body>
</html>

<style>
  header {
    border-bottom: 1px solid var(--ink);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding: 18px clamp(16px, 4vw, 48px) 12px;
  }
  .wordmark {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .wordmark i {
    font-weight: 400;
  }
  nav {
    display: flex;
    gap: 22px;
    font-size: 16px;
  }
  nav a {
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 2px solid transparent;
  }
  nav a[aria-current="page"] {
    border-bottom-color: var(--accent);
  }
</style>
