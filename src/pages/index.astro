---
import Contents from "../components/Contents.astro";
import Footer from "../components/Footer.astro";
import Progress from "../components/Progress.astro";
import Base from "../layouts/Base.astro";
import { getLessons, lessonUrl } from "../lib/lessons";

const lessons = await getLessons();
const exercises = lessons.reduce((n, l) => n + l.data.tasks.length, 0);
---

<Base
  title="Drums Roadmap"
  section="roadmap"
  description="A free, step-by-step roadmap for drummers, from your first beat to odd time. Real drum notation you can play in the browser."
>
  <main>
    <p class="label">A free roadmap for drummers</p>
    <h1>From your first beat to odd time</h1>
    <p class="lede">
      {lessons.length} lessons and {exercises} exercises in three parts. Every exercise has a clear
      goal, drum notation you can play in the browser, and a video lesson. Tick exercises off to
      unlock the next lesson.
    </p>
    <a class="button start" href={lessonUrl(lessons[0])} data-continue>
      Start lesson 1
    </a>
    <Contents lessons={lessons} withIntros />
    <Footer withReset />
  </main>
  <Progress lessons={lessons} />
</Base>

<style>
  main {
    max-width: 820px;
    margin: 0 auto;
    padding: 40px 16px 80px;
  }
  .start {
    font-size: 17px;
    padding: 8px 18px;
    background: var(--ink);
    color: var(--paper);
  }
  .start:hover {
    background: var(--accent);
    border-color: var(--accent);
  }
</style>
