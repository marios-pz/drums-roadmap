---
import { roadmapIds, type Lesson } from "../lib/lessons";

interface Props {
  lessons: Lesson[];
}

// Exercise ids per lesson, read by the progress script. Also renders the "unlocked" toast.
const ids = roadmapIds(Astro.props.lessons);
---

<script type="application/json" id="roadmap-data" set:html={JSON.stringify(ids)} />
<div class="toast" role="status" data-toast></div>

<script>
  import "../scripts/roadmap";
</script>

<style>
  .toast {
    position: fixed;
    left: 50%;
    bottom: 24px;
    transform: translate(-50%, 16px);
    opacity: 0;
    transition: 0.25s;
    pointer-events: none;
    background: var(--ink);
    color: var(--paper);
    padding: 10px 18px;
    font-size: 16px;
  }
  .toast.show {
    opacity: 1;
    transform: translate(-50%, 0);
  }
</style>
